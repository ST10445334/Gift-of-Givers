@using Microsoft.AspNetCore.Identity
@using Gift_of_Givers.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Gift of the Givers
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Gift_of_Givers.styles.css"
          asp-append-version="true" />

</head>


<body>

    <!-- =========================================
         HEADER
         ========================================= -->

    <header class="site-header">

        <nav class="main-nav">

            <div class="container nav-container">

                <!-- BRAND -->

                <a class="brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-mark">
                        G
                    </span>

                    <span class="brand-text">
                        Gift of the Givers
                    </span>

                </a>


                <!-- MOBILE MENU BUTTON -->

                <button class="mobile-menu-button"
                        type="button"
                        onclick="toggleMenu()"
                        aria-label="Open navigation menu">

                    ☰

                </button>


                <!-- NAVIGATION -->

                <div id="mainMenu"
                     class="navigation">

                    <a asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>

                    <a asp-controller="Home"
                       asp-action="About">
                        About
                    </a>

                    <a asp-controller="Donation"
                       asp-action="Index">
                        Donate
                    </a>

                    <a asp-controller="Volunteer"
                       asp-action="Index">
                        Volunteer
                    </a>

                    <a asp-controller="AreasOfNeed"
                       asp-action="Index">
                        Areas of Need
                    </a>

                    <a asp-controller="Contact"
                       asp-action="Index">
                        Contact
                    </a>


                    @if (SignInManager.IsSignedIn(User))
                    {
                        if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin"
                               asp-action="Index">
                                Admin
                            </a>
                        }

                        <a asp-controller="Donation"
                           asp-action="Donate"
                           class="nav-login">
                            Give Now
                        </a>

                        <form asp-page="/Accounts/Logout"
                              method="post"
                              style="display:inline; margin:0;">

                            <button type="submit"
                                    class="nav-login"
                                    style="border:none; cursor:pointer;">
                                Sign Out
                            </button>

                        </form>
                    }
                    else
                    {
                        <a asp-page="/Accounts/Login"
                           class="nav-login">
                            Sign In
                        </a>

                        <a asp-page="/Accounts/Register"
                           class="nav-login">
                            Register
                        </a>
                    }

                </div>

            </div>

        </nav>

    </header>


    <!-- =========================================
         PAGE CONTENT
         ========================================= -->

    <main>

        @RenderBody()

    </main>


    <!-- =========================================
         FOOTER
         ========================================= -->

    <footer class="site-footer">

        <div class="container footer-grid">

            <div>

                <div class="footer-brand">
                    Gift of the Givers
                </div>

                <p>
                    A humanitarian response platform connecting
                    people, resources, volunteers and relief
                    operations.
                </p>

            </div>


            <div>

                <h4>
                    Platform
                </h4>

                <a asp-controller="Home"
                   asp-action="Index">
                    Home
                </a>

                <a asp-controller="Home"
                   asp-action="About">
                    About
                </a>

                <a asp-controller="Donation"
                   asp-action="Index">
                    Donate
                </a>

                <a asp-controller="Volunteer"
                   asp-action="Index">
                    Volunteer
                </a>

                <a asp-controller="AreasOfNeed"
                   asp-action="Index">
                    Areas of Need
                </a>

            </div>


            <div>

                <h4>
                    Support
                </h4>

                <a asp-controller="Contact"
                   asp-action="Index">
                    Contact Us
                </a>

                <a asp-controller="Home"
                   asp-action="Privacy">
                    Privacy
                </a>

            </div>

        </div>


        <div class="footer-bottom">

            <div class="container">

                <span>
                    © 2026 Gift of the Givers Platform
                </span>

                <span>
                    Humanitarian Response & Recovery
                </span>

            </div>

        </div>

    </footer>


    <!-- =========================================
         JAVASCRIPT
         ========================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false)

</body>

</html>