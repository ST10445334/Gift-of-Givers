@{
    ViewData["Title"] = "About";
}

<section class="page-hero">

    <div class="container">

        <span class="eyebrow">
            ABOUT THE PLATFORM
        </span>

        <h1>
            Coordinating help when
            <span>people need it most.</span>
        </h1>

        <p>
            The Gift of the Givers humanitarian platform is designed
            to connect people, resources, volunteers and relief
            operations through one coordinated digital system.
        </p>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="about-grid">

            <div>

                <span class="eyebrow">
                    OUR PURPOSE
                </span>

                <h2>
                    One platform. Many ways to help.
                </h2>

            </div>

            <div>

                <p>
                    During a disaster, information and resources need
                    to move quickly. The platform is designed to bring
                    important humanitarian activities into one
                    coordinated environment.
                </p>

                <p>
                    Donations, volunteers, relief projects and
                    operational information can be managed through
                    connected digital services.
                </p>

            </div>

        </div>

    </div>

</section>


<section class="section about-section">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                PLATFORM AREAS
            </span>

            <h2>
                Connecting the humanitarian response
            </h2>

            <p>
                The platform can grow as the organisation's operational
                requirements grow.
            </p>

        </div>


        <div class="feature-grid">

            <div class="feature-card">

                <div class="feature-number">
                    01
                </div>

                <h3>
                    Donations
                </h3>

                <p>
                    Record and coordinate financial contributions
                    toward approved humanitarian relief projects.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-number">
                    02
                </div>

                <h3>
                    Volunteers
                </h3>

                <p>
                    Register volunteers, their skills, availability
                    and participation in relief projects.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-number">
                    03
                </div>

                <h3>
                    Relief Projects
                </h3>

                <p>
                    Organise humanitarian activities and monitor
                    their progress and resource requirements.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-number">
                    04
                </div>

                <h3>
                    Operations
                </h3>

                <p>
                    Support logistics, locations, supplies and
                    operational coordination as the platform expands.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-number">
                    05
                </div>

                <h3>
                    Shelter & Recovery
                </h3>

                <p>
                    Help identify suitable facilities for displaced
                    communities and support longer-term recovery.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-number">
                    06
                </div>

                <h3>
                    Community Recovery
                </h3>

                <p>
                    Connect displaced people with skills, opportunities
                    and organisations that can support their recovery.
                </p>

            </div>

        </div>

    </div>

</section>


<section class="about-cta">

    <div class="container">

        <div>

            <span class="eyebrow">
                GET INVOLVED
            </span>

            <h2>
                Help build a stronger response.
            </h2>

            <p>
                Volunteers and donors can become part of the
                humanitarian response through the platform.
            </p>

        </div>

        <div class="action-buttons">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-light">
                Back to Home
            </a>

        </div>

    </div>

</section>