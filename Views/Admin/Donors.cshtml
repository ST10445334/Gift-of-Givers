@model List<Gift_of_Givers.Models.Donation>
@{
    ViewData["Title"] = "Donors";
}

<section class="section">
    <div class="container">

        <h2>Donations</h2>
        <p style="color: var(--muted);">Every donation recorded on the platform.</p>

        <table class="table" style="margin-top:20px;">
            <thead>
                <tr>
                    <th>Donor</th>
                    <th>Email</th>
                    <th>Amount</th>
                    <th>Type</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" style="color: var(--muted);">No donations yet.</td></tr>
                }
                else
                {
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td>@d.DonorName</td>
                            <td>@d.DonorEmail</td>
                            <td>@d.Currency @d.Amount</td>
                            <td>@d.DonationType</td>
                            <td>@d.DonatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>
</section>
